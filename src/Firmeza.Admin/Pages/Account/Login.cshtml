@page
@model Firmeza.Admin.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Firmeza — Login</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 min-h-screen flex items-center justify-center">
    <div class="bg-white rounded-2xl shadow-xl p-10 w-full max-w-md">
        <h1 class="text-3xl font-bold text-gray-800 mb-2">Firmeza</h1>
        <p class="text-base text-gray-500 mb-8">Panel Administrativo</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6 text-base">
                @Model.ErrorMessage
            </div>
        }

        <form method="post" class="space-y-5">
            <div>
                <label class="block text-base font-medium text-gray-700 mb-1">Email</label>
                <input asp-for="Email" type="email"
                       class="w-full border border-gray-300 rounded-lg px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-gray-400" />
                <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
            </div>
            <div>
                <label class="block text-base font-medium text-gray-700 mb-1">Contraseña</label>
                <input asp-for="Password" type="password"
                       class="w-full border border-gray-300 rounded-lg px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-gray-400" />
                <span asp-validation-for="Password" class="text-red-500 text-sm"></span>
            </div>
            <button type="submit"
                    class="w-full bg-gray-900 text-white py-3 rounded-lg text-base font-medium hover:bg-gray-700 transition">
                Ingresar
            </button>
        </form>
    </div>
</body>
</html>