@page "{id:int}"
@model Firmeza.Admin.Pages.Clients.EditModel
@{
    ViewData["Title"] = "Editar Cliente";
}

<div class="max-w-2xl bg-white rounded-xl shadow p-8">
    <form method="post" class="space-y-5">
        <input type="hidden" asp-for="Client.Id" />
        <div>
            <label class="block text-base font-medium text-gray-700 mb-1">Nombre completo</label>
            <input asp-for="Client.FullName"
                   class="w-full border border-gray-300 rounded-lg px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-gray-400" />
        </div>
        <div>
            <label class="block text-base font-medium text-gray-700 mb-1">Documento</label>
            <input asp-for="Client.Document"
                   class="w-full border border-gray-300 rounded-lg px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-gray-400" />
        </div>
        <div>
            <label class="block text-base font-medium text-gray-700 mb-1">Email</label>
            <input asp-for="Client.Email" type="email"
                   class="w-full border border-gray-300 rounded-lg px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-gray-400" />
        </div>
        <div>
            <label class="block text-base font-medium text-gray-700 mb-1">Teléfono</label>
            <input asp-for="Client.Phone"
                   class="w-full border border-gray-300 rounded-lg px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-gray-400" />
        </div>
        <div class="flex gap-4 pt-2">
            <button type="submit"
                    class="bg-blue-600 text-white px-6 py-3 rounded-lg text-base hover:bg-blue-500 transition">
                Actualizar
            </button>
            <a href="/Clients"
               class="bg-gray-200 text-gray-700 px-6 py-3 rounded-lg text-base hover:bg-gray-300 transition">
                Cancelar
            </a>
        </div>
    </form>
</div>