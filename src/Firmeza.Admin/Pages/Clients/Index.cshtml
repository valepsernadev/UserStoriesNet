@page
@model Firmeza.Admin.Pages.Clients.IndexModel
@{
    ViewData["Title"] = "Clientes";
}

<div class="flex justify-between items-center mb-6">
    <form method="get" class="flex gap-3">
        <input type="text" name="search" value="@Model.Search"
               placeholder="Buscar por nombre o documento..."
               class="border border-gray-300 rounded-lg px-4 py-2 text-base w-80 focus:outline-none focus:ring-2 focus:ring-gray-400" />
        <button type="submit"
                class="bg-gray-800 text-white px-5 py-2 rounded-lg text-base hover:bg-gray-700 transition">
            Buscar
        </button>
    </form>
    <a href="/Clients/Create"
       class="bg-green-600 text-white px-5 py-2 rounded-lg text-base hover:bg-green-500 transition">
        + Nuevo Cliente
    </a>
</div>

<div class="bg-white rounded-xl shadow overflow-hidden">
    <table class="w-full text-base">
        <thead class="bg-gray-800 text-white">
            <tr>
                <th class="px-6 py-4 text-left">Nombre</th>
                <th class="px-6 py-4 text-left">Documento</th>
                <th class="px-6 py-4 text-left">Email</th>
                <th class="px-6 py-4 text-left">Teléfono</th>
                <th class="px-6 py-4 text-left">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var client in Model.Clients)
            {
                <tr class="border-b hover:bg-gray-50 transition">
                    <td class="px-6 py-4 font-medium">@client.FullName</td>
                    <td class="px-6 py-4">@client.Document</td>
                    <td class="px-6 py-4 text-gray-500">@client.Email</td>
                    <td class="px-6 py-4">@client.Phone</td>
                    <td class="px-6 py-4 flex gap-3">
                        <a href="/Clients/Edit/@client.Id"
                           class="text-blue-600 hover:underline">Editar</a>
                        <a href="/Clients/Delete/@client.Id"
                           class="text-red-600 hover:underline">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>