@page
@model Firmeza.Admin.Pages.Export.IndexModel
@{
    ViewData["Title"] = "Exportación";
}

<div class="max-w-2xl bg-white rounded-xl shadow p-8">
    <p class="text-base text-gray-600 mb-8">
        Descarga los datos del sistema en formato Excel (.xlsx).
    </p>

    <div class="space-y-4">
        <div class="flex items-center justify-between border border-gray-200 rounded-lg px-6 py-4">
            <div>
                <p class="text-base font-medium text-gray-800">Productos</p>
                <p class="text-sm text-gray-500">Nombre, descripción, precio, stock y estado</p>
            </div>
            <a href="?handler=Products"
               class="bg-green-600 text-white px-5 py-2 rounded-lg text-base hover:bg-green-500 transition">
                Exportar
            </a>
        </div>

        <div class="flex items-center justify-between border border-gray-200 rounded-lg px-6 py-4">
            <div>
                <p class="text-base font-medium text-gray-800">Clientes</p>
                <p class="text-sm text-gray-500">Nombre, documento, email y teléfono</p>
            </div>
            <a href="?handler=Clients"
               class="bg-blue-600 text-white px-5 py-2 rounded-lg text-base hover:bg-blue-500 transition">
                Exportar
            </a>
        </div>

        <div class="flex items-center justify-between border border-gray-200 rounded-lg px-6 py-4">
            <div>
                <p class="text-base font-medium text-gray-800">Ventas</p>
                <p class="text-sm text-gray-500">Cliente, fecha y total por venta</p>
            </div>
            <a href="?handler=Sales"
               class="bg-gray-700 text-white px-5 py-2 rounded-lg text-base hover:bg-gray-600 transition">
                Exportar
            </a>
        </div>
    </div>
</div>
