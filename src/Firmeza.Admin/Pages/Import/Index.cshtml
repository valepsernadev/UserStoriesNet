@page
@model Firmeza.Admin.Pages.Import.IndexModel
@{
    ViewData["Title"] = "Carga Masiva";
}

<div class="max-w-2xl bg-white rounded-xl shadow p-8">
    <p class="text-base text-gray-500 mb-6">
        Sube un archivo Excel con hojas de productos y/o clientes. El sistema detecta automáticamente el tipo de datos.
    </p>

    @if (Model.Result is not null)
    {
        <div class="mb-6 p-4 rounded-lg @(Model.Result.Errors.Count == 0 ? "bg-green-50 border border-green-200" : "bg-yellow-50 border border-yellow-200")">
            <p class="text-base font-medium text-gray-800 mb-1">Importación completada</p>
            <p class="text-sm text-gray-600">✅ Productos importados: @Model.Result.ProductsImported</p>
            <p class="text-sm text-gray-600">✅ Clientes importados: @Model.Result.ClientsImported</p>

            @if (Model.Result.Errors.Count > 0)
            {
                <p class="text-sm font-medium text-yellow-700 mt-3 mb-1">⚠️ Errores encontrados:</p>
                @foreach (var error in Model.Result.Errors)
                {
                    <p class="text-sm text-yellow-600">— @error</p>
                }
            }
        </div>
    }

    <form method="post" enctype="multipart/form-data" class="space-y-5">
        <div>
            <label class="block text-base font-medium text-gray-700 mb-1">Archivo Excel (.xlsx)</label>
            <input type="file" name="file" accept=".xlsx"
                   class="w-full border border-gray-300 rounded-lg px-4 py-3 text-base focus:outline-none" />
        </div>
        <button type="submit"
                class="bg-gray-800 text-white px-6 py-3 rounded-lg text-base hover:bg-gray-700 transition">
            Importar
        </button>
    </form>
</div>