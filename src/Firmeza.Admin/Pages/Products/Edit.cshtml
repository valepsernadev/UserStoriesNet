@page "{id:int}"
@model Firmeza.Admin.Pages.Products.EditModel
@{
    ViewData["Title"] = "Editar Producto";
}

<div class="max-w-2xl bg-white rounded-xl shadow p-8">
    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
    {
        <div class="mb-5 bg-red-50 border border-red-300 text-red-700 rounded-lg px-5 py-4 text-base">
            <ul class="list-disc list-inside space-y-1">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }
    <form method="post" class="space-y-5">
        <input type="hidden" asp-for="Product.Id" />
        <div>
            <label class="block text-base font-medium text-gray-700 mb-1">Nombre</label>
            <input asp-for="Product.Name"
                   class="w-full border border-gray-300 rounded-lg px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-gray-400" />
            <span asp-validation-for="Product.Name" class="text-red-500 text-sm"></span>
        </div>
        <div>
            <label class="block text-base font-medium text-gray-700 mb-1">Descripción</label>
            <textarea asp-for="Product.Description" rows="3"
                      class="w-full border border-gray-300 rounded-lg px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-gray-400"></textarea>
        </div>
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-base font-medium text-gray-700 mb-1">Precio</label>
                <input asp-for="Product.Price" type="number" step="0.01"
                       class="w-full border border-gray-300 rounded-lg px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-gray-400" />
            </div>
            <div>
                <label class="block text-base font-medium text-gray-700 mb-1">Stock</label>
                <input asp-for="Product.Stock" type="number"
                       class="w-full border border-gray-300 rounded-lg px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-gray-400" />
            </div>
        </div>
        <div>
            <label class="flex items-center gap-2 text-base text-gray-700">
                <input asp-for="Product.IsActive" type="checkbox" class="w-4 h-4" />
                Producto activo
            </label>
        </div>
        <div class="flex gap-4 pt-2">
            <button type="submit"
                    class="bg-blue-600 text-white px-6 py-3 rounded-lg text-base hover:bg-blue-500 transition">
                Actualizar
            </button>
            <a href="/Products"
               class="bg-gray-200 text-gray-700 px-6 py-3 rounded-lg text-base hover:bg-gray-300 transition">
                Cancelar
            </a>
        </div>
    </form>
</div>