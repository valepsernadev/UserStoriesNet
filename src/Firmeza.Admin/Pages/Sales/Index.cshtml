@page
@model Firmeza.Admin.Pages.Sales.IndexModel
@{
    ViewData["Title"] = "Ventas";
}

@if (TempData["Success"] is string successMsg)
{
    <div class="mb-4 bg-green-50 border border-green-300 text-green-700 rounded-lg px-5 py-4 text-base">
        @successMsg
    </div>
}

<div class="flex justify-between items-center mb-6">
    <h2 class="text-xl font-semibold text-gray-700">Historial de ventas</h2>
    <a href="/Sales/Create"
       class="bg-green-600 text-white px-5 py-2 rounded-lg text-base hover:bg-green-500 transition">
        + Nueva Venta
    </a>
</div>

<div class="bg-white rounded-xl shadow overflow-hidden">
    <table class="w-full text-base">
        <thead class="bg-gray-800 text-white">
        <tr>
            <th class="px-6 py-4 text-left">#</th>
            <th class="px-6 py-4 text-left">Cliente</th>
            <th class="px-6 py-4 text-left">Fecha</th>
            <th class="px-6 py-4 text-left">Total</th>
            <th class="px-6 py-4 text-left">Acciones</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var sale in Model.Sales)
        {
            <tr class="border-b hover:bg-gray-50 transition">
                <td class="px-6 py-4 font-medium">#@sale.Id</td>
                <td class="px-6 py-4">@sale.Client.FullName</td>
                <td class="px-6 py-4 text-gray-500">@sale.SaleDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                <td class="px-6 py-4 font-semibold">$@sale.Total.ToString("N2")</td>
                <td class="px-6 py-4 flex gap-3">
                    <a href="/Sales/Receipt/@sale.Id"
                       class="text-blue-600 hover:underline">Descargar recibo</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>